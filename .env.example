OPENAI_KEY=
REVIEWER_MODEL=
HEADER_EXTRACTOR_MODEL=

# GROBID base URL as reached by the backend container.
# Leave as-is for docker-compose (points at the grobid service on the compose network).
GROBID_URL=http://grobid:8070

# Comma-separated list of origins allowed to call the backend API.
CORS_ORIGINS=http://localhost:8080

# Base URL the browser uses to reach the backend API (must be browser-reachable,
# not a Docker-internal hostname).
API_BASE_URL=http://localhost:8000

MAX_UPLOAD_MB=20

# Citation lookup for the reference-checker agent. The user picks the provider
# per review (default: Tavily); only the selected provider's key is needed.

# Required to use Tavily (the default) as the citation lookup provider.
TAVILY_API_KEY=

# Optional: raises the Semantic Scholar API rate limit for the reference-checker
# agent when Semantic Scholar is selected as the citation lookup provider. Its
# public search endpoint works fine unauthenticated at low volume.
SEMANTIC_SCHOLAR_API_KEY=
